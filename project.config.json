{
  "description": "裕和堂门店预约小程序 / 原生微信小程序",
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "yuhetang-miniprogram",
  "libVersion": "3.9.3",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "checkSiteMap": true
  },
  "condition": {},
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tools"
      },
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "file",
        "value": "package.json"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": ".gitignore"
      },
      {
        "type": "file",
        "value": ".gitattributes"
      }
    ]
  }
}
