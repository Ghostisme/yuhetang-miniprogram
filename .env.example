# Build-time public configuration only; never put AppSecret, Token or AES keys here.
TARO_APP_API_BASE=https://booking.yuhetangtcm.com
# For local H5 testing, leave TARO_APP_API_BASE empty and use the proxy below.
API_PROXY_TARGET=http://127.0.0.1:8790
# Explicit local-only customer identity; production builds always disable this.
TARO_APP_DEV_LOGIN=false
