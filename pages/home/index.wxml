<view class="page" style="{{site.themeStyle}}" wx:if="{{site}}">
  <view class="brand"><view class="seal"><view>裕</view><view>和</view></view><view><view class="brand-name">{{site.brandName}}</view><text class="english">{{site.brandEnglish}}</text></view></view>
  <button class="tiny" style="padding:15rpx;background:#e9edde;text-align:center" bindtap="orders">查看我的预约申请 ›</button>
  <view class="hero"><image src="{{site.hero.image}}" mode="aspectFill"/><view class="hero-shade"/><view class="hero-copy"><text class="eyebrow">{{site.hero.eyebrow}}</text><view class="title">{{site.hero.title}}</view><view class="subtitle">{{site.hero.subtitle}}</view><button class="hero-button" bindtap="book">{{site.hero.button}}　→</button></view></view>
  <view class="quick-links"><button bindtap="catalog"><text class="symbol">♧</text>特色养护<text class="sub">照顾身心</text></button><button bindtap="stores"><text class="symbol">⌖</text>城市门店<text class="sub">遇见一处静谧</text></button><button bindtap="products"><text class="symbol">❧</text>东方好物<text class="sub">草木的温度</text></button></view>
  <block wx:for="{{site.sections}}" wx:key="id">
    <view class="section" wx:if="{{item.enabled && item.id === 'services'}}"><text class="eyebrow">THE ART OF CARE</text><view class="section-heading"><text class="heading">从一场放松开始</text><button class="link" bindtap="catalog">探索更多 →</button></view><view class="grid"><view class="card" wx:for="{{services}}" wx:key="id"><image src="{{item.image}}" mode="aspectFill"/><view class="card-body"><view class="card-title">{{item.name}}</view><view class="muted">{{item.subtitle}}</view><button class="primary" data-service="{{item.id}}" bindtap="book">了解并申请 →</button></view></view></view></view>
    <view class="section" wx:if="{{item.enabled && item.id === 'space'}}"><text class="eyebrow">A PLACE TO UNWIND</text><view class="section-heading"><text class="heading">把城市留在门外</text><button class="link" bindtap="stores">全部门店 →</button></view><view wx:for="{{stores}}" wx:key="id" class="card" style="margin-bottom:24rpx" bindtap="stores"><image style="height:330rpx" src="{{item.image}}" mode="aspectFill"/><view class="card-body"><view class="card-title">{{item.name}}</view><view class="muted">{{item.address}}</view></view></view></view>
    <view class="section" wx:if="{{item.enabled && item.id === 'products'}}"><text class="eyebrow">BOTANICAL EVERYDAY</text><view class="section-heading"><text class="heading">东方好物，日常相伴</text><button class="link" bindtap="products">看一看 →</button></view><view class="grid"><view class="card" wx:for="{{products}}" wx:key="id" bindtap="products"><image src="{{item.image}}" mode="aspectFill"/><view class="card-body"><view class="card-title">{{item.name}}</view><view class="muted">{{item.subtitle}}</view></view></view></view></view>
    <view class="intro" wx:if="{{item.enabled && item.id === 'brand'}}"><text class="eyebrow">OUR PHILOSOPHY</text><view class="heading">东方养护，自在有和。</view><view class="muted">{{site.tagline}}</view><button class="link" style="margin-top:25rpx;text-align:left" bindtap="story">走近裕和堂 →</button></view>
  </block>
  <view class="section"><view class="banner"><text class="strong">温馨提示</text>线上提交为预约申请，需门店人工确认。调理师意向与到店安排以门店回复为准。</view><button class="secondary" open-type="contact" session-from="home">微信客服 · 有事请随时联系我们</button></view><view class="footer">YU HE TANG · WELLNESS &amp; CARE</view>
</view><view class="error-bar" wx:if="{{error}}">{{error}}<button bindtap="load">点击重试</button></view>
