<view class="page" style="{{site.themeStyle}}" wx:if="{{site}}"><block wx:if="{{!selected}}"><view class="intro"><text class="eyebrow">A PLACE TO UNWIND</text><view class="heading">把城市留在门外。</view><view class="muted">选一家门店，留一段时间给自己。</view></view><view class="toolbar"><button wx:for="{{districts}}" wx:key="*this" data-district="{{item}}" bindtap="district" class="{{district===item?'active':''}}">{{item}}</button></view><view class="store-card" wx:for="{{stores}}" wx:key="id"><image src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="detail"/><view class="card-body"><view class="tiny">{{item.district}} · {{item.tag}}</view><view class="card-title">裕和堂 · {{item.name}}</view><view class="muted">{{item.address}}</view><view class="tiny">营业时间 {{item.hours}}</view><view class="store-actions"><button data-id="{{item.id}}" bindtap="detail">门店与空间</button><button class="green" data-id="{{item.id}}" bindtap="book">{{item.onlineBooking?'申请到店 →':'电话咨询'}}</button></view></view></view></block>
  <block wx:else><image class="cover" src="{{selected.image}}" mode="aspectFill"/><view class="section"><button class="back-link" bindtap="back">‹ 全部门店</button><text class="eyebrow">{{selected.district}} · {{selected.tag}}</text><view class="heading" style="margin-top:24rpx">裕和堂 · {{selected.name}}</view><view class="article">{{selected.description}}</view><view class="muted">{{selected.address}}</view><view class="muted">{{selected.hours}}</view><view class="store-actions"><button bindtap="map">地图导航</button><button bindtap="call">联系门店</button></view><view class="heading" style="margin-top:55rpx">空间里的小确幸</view><view class="gallery"><image wx:for="{{selected.gallery}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="preview"/></view></view><view class="bottom-actions"><button class="contact" open-type="contact" session-from="stores">微信客服</button><button class="primary" data-id="{{selected.id}}" bindtap="book">{{selected.onlineBooking?'预约这家门店 →':'电话联系门店'}}</button></view></block>
</view><view class="error-bar" wx:if="{{error}}">{{error}}</view>
