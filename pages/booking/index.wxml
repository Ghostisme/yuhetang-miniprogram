<view class="page" style="{{site.themeStyle}}" wx:if="{{site}}"><block wx:if="{{!receipt}}"><view class="intro"><text class="eyebrow">A MOMENT FOR YOURSELF</text><view class="heading">预约一段好时光。</view><view class="muted">在线申请 · 门店确认 · 安心到店</view></view><view class="steps"><button wx:for="{{steps}}" wx:key="*this" data-step="{{index}}" bindtap="step" class="{{step===index?'active':''}}"><text class="n">{{index+1}}</text>{{item}}</button></view><view class="section">
    <block wx:if="{{step===0}}"><view class="heading">选择到店门店</view><view class="muted" style="margin-top:15rpx">找一处方便的所在，给自己留一点时间。</view><button class="choice {{storeId===item.id?'selected':''}}" wx:for="{{site.stores}}" wx:key="id" wx:if="{{item.onlineBooking}}" data-id="{{item.id}}" bindtap="store"><image src="{{item.image}}" mode="aspectFill"/><view class="info"><view class="tiny">{{item.district}}</view><view class="card-title">{{item.name}}</view><view class="tiny">{{item.address}}</view></view><view class="check">{{storeId===item.id?'✓':''}}</view></button></block>
    <block wx:elif="{{step===1}}"><view class="pill">{{store.name}}</view><view class="heading" style="margin:25rpx 0">选择养护项目</view><view wx:if="{{servicesLoading}}" class="muted">正在加载本店项目…</view><view wx:elif="{{!services.length}}" class="empty">本店暂无开放项目，请联系客服。</view><button class="choice {{serviceId===item.id?'selected':''}}" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" bindtap="service"><image src="{{item.image}}" mode="aspectFill"/><view class="info"><view class="card-title">{{item.name}}</view><view class="tiny">{{item.subtitle}}</view><view class="pill">参考 {{item.duration}}</view></view><view class="check">{{serviceId===item.id?'✓':''}}</view></button><view class="muted">本笔同行客户采用相同门店、项目与时段。</view></block>
    <block wx:elif="{{step===2}}"><view class="pill">{{store.name}} · {{service.name}}</view><view class="heading" style="margin:25rpx 0">选择到店时间</view><view class="two-fields"><view class="field"><text class="label">到店日期</text><picker mode="date" value="{{date}}" start="{{today}}" end="{{lastDay}}" bindchange="date"><view class="picker">{{date}}　⌄</view></picker></view><view class="field"><text class="label">同行人数</text><picker range="{{counts}}" value="{{headcount-1}}" bindchange="count"><view class="picker">{{headcount}} 人　⌄</view></picker></view></view><view class="tiny">请选择开始时段 · 名额以实际提交结果为准</view><view class="slot-grid"><button wx:for="{{slots}}" wx:key="time" class="{{startTime===item.time?'active':''}}" disabled="{{!item.available || item.remaining < headcount}}" data-time="{{item.time}}" bindtap="slot">{{item.time}}<text class="tiny">{{item.available?'余 '+item.remaining+' 位':'暂不可约'}}</text></button></view><view class="banner">所选时间为到店意向，具体接待须经门店人工确认；调理师由门店统筹安排。</view></block>
    <block wx:else><view class="pill">{{store.name}} · {{service.name}}</view><view class="muted" style="margin:20rpx 0">{{date}}　{{startTime}}　·　{{headcount}}人同行</view><view class="heading">留个联系方式，静候门店回复。</view><view class="field"><text class="label">您的称呼 *</text><input class="input" value="{{name}}" maxlength="40" placeholder="便于门店称呼您" data-field="name" bindinput="input"/></view><view class="field"><text class="label">联系电话 *</text><input class="input" type="number" value="{{phone}}" maxlength="11" placeholder="门店将与您核对到店安排" data-field="phone" bindinput="input"/></view><view class="field"><text class="label">意向调理师（可选）</text><picker disabled="{{teachersLoading}}" range="{{teacherNames}}" value="{{teacherIndex}}" data-field="teacherIndex" bindchange="select"><view class="picker">{{teachersLoading?'正在加载本店调理师…':teacherNames[teacherIndex]}}　⌄</view></picker><view class="tiny" style="margin-top:12rpx">仅显示{{store.name}}的调理师。选择仅表达偏好，不代表已锁定老师；多人同行由本店统一分配。</view></view><view class="two-fields"><view class="field"><text class="label">是否为会员 *</text><picker range="{{claimNames}}" value="{{memberIndex}}" data-field="memberIndex" bindchange="select"><view class="picker">{{claimNames[memberIndex]}}　⌄</view></picker></view><view class="field"><text class="label">是否来过裕和堂 *</text><picker range="{{claimNames}}" value="{{visitedIndex}}" data-field="visitedIndex" bindchange="select"><view class="picker">{{claimNames[visitedIndex]}}　⌄</view></picker></view></view><view class="tiny">会员情况由您自述，具体权益与档案请由门店核实。</view><view class="field"><text class="label">想对门店说的话（选填）</text><textarea value="{{remark}}" maxlength="500" placeholder="如调理师偏好、沟通事项；请勿填写无关敏感信息" data-field="remark" bindinput="input"/></view><checkbox-group data-field="privacyConsent" bindchange="agree"><label class="agree"><checkbox value="yes" checked="{{privacyConsent}}" color="#435e4b"/><view>我已阅读并同意<button class="text-link" bindtap="privacy">《预约隐私说明》</button>，同意为本次接待处理必要的预约信息。</view></label></checkbox-group><checkbox-group data-field="sensitiveConsent" bindchange="agree"><label class="agree"><checkbox value="yes" checked="{{sensitiveConsent}}" color="#435e4b"/><view>若我主动在备注提供健康等敏感信息，同意门店仅用于本次接待沟通（非必选）。</view></label></checkbox-group><view class="banner"><text class="strong">温馨提示：提交申请 ≠ 预约成功</text>门店人员将人工核实时间、人数与调理师安排。请等待门店确认后再按约到店；如临近到店仍未收到回复，请主动联系门店。</view><button class="primary" loading="{{busy}}" disabled="{{busy || servicesLoading}}" bindtap="submit">提交预约申请 · 等待门店确认</button><customer-service store-id="{{storeId}}" label="微信客服 · 联系本店"/></block>
    <view class="error-bar" wx:if="{{error}}">{{error}}</view><button class="primary" wx:if="{{step<3}}" disabled="{{step===1 &amp;&amp; servicesLoading}}" bindtap="next">下一步 →</button><button class="link" style="margin:30rpx auto 0" wx:if="{{step>0}}" bindtap="prev">返回上一步</button>
  </view></block><view class="receipt" wx:else><view class="receipt-icon">◷</view><text class="eyebrow">REQUEST RECEIVED</text><view class="heading">申请已提交<view>等待门店确认</view></view><view class="banner"><text class="strong">当前尚未预约成功</text>我们已收到您的到店意向。门店将人工核对接待安排，请以门店确认结果为准。</view><view class="receipt-card"><view class="status">待门店确认</view><view class="card-title">{{receipt.serviceName}}</view><view class="muted">{{receipt.storeName}}</view><view class="receipt-row"><text class="label">到店意向</text><text class="value">{{receipt.bookingDate}} {{receipt.startTime}}</text></view><view class="receipt-row"><text class="label">同行人数</text><text class="value">{{receipt.headcount}}人</text></view><view class="receipt-row"><text class="label">调理师意向</text><text class="value">{{receipt.therapistIntentName}}</text></view><view class="tiny" style="margin-top:20rpx">申请编号 {{receipt.id}}</view></view><button class="primary" bindtap="orders">查看我的预约申请</button><button class="secondary" bindtap="call">电话联系门店</button><customer-service store-id="{{receipt.storeId || storeId}}" label="微信客服 · 联系本店"/></view></view>
