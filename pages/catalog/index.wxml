<view class="page" style="{{site.themeStyle}}" wx:if="{{site}}"><view class="intro"><text class="eyebrow">WELLNESS AT YU HE TANG</text><view class="heading">慢下来，照顾好自己。</view><view class="muted">一段属于自己的养护时光。</view></view><view class="toolbar"><button class="{{tab==='services'?'active':''}}" data-tab="services" bindtap="tab">特色养护</button><button class="{{tab==='products'?'active':''}}" data-tab="products" bindtap="tab">东方好物</button><button class="{{tab==='space'?'active':''}}" data-tab="space" bindtap="tab">门店空间</button><button class="{{tab==='brand'?'active':''}}" data-tab="brand" bindtap="tab">品牌故事</button></view>
  <block wx:if="{{selected}}"><image class="cover" src="{{selected.image}}" mode="aspectFill"/><view class="section"><button class="back-link" bindtap="back">‹ 返回列表</button><text class="eyebrow">{{selected.english || selected.category}}</text><view class="heading" style="margin-top:20rpx">{{selected.name}}</view><view class="muted" style="margin-top:15rpx">{{selected.subtitle}}</view><view class="article">{{selected.description}}</view><view class="pill" wx:if="{{selected.duration}}">参考体验时长 {{selected.duration}}</view><view class="muted" wx:for="{{selected.steps}}" wx:key="*this">{{index+1}} · {{item}}</view></view><view class="bottom-actions"><customer-service variant="compact"/><button wx:if="{{tab==='services'}}" class="primary" bindtap="book">申请到店体验 →</button><text wx:else class="muted">产品展示 · 到店咨询</text></view></block>
  <view class="section" wx:elif="{{tab==='services' || tab==='products'}}"><view class="grid"><button class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.image}}" mode="aspectFill"/><view class="card-body"><view class="card-title">{{item.name}}</view><view class="muted">{{item.subtitle}}</view><view class="pill">{{tab==='services'?'了解项目 →':'了解好物 →'}}</view></view></button></view></view>
  <view class="section" wx:elif="{{tab==='space'}}"><view wx:for="{{site.galleryGroups}}" wx:key="id" style="margin-bottom:45rpx"><view class="heading">{{item.name}}</view><view class="gallery"><image wx:for="{{item.images}}" wx:for-item="url" wx:key="*this" src="{{url}}" mode="aspectFill" data-url="{{url}}" data-urls="{{item.images}}" bindtap="preview"/></view></view></view>
  <view class="section" wx:else><text class="eyebrow">OUR PHILOSOPHY</text><view class="heading" style="margin:25rpx 0">{{site.tagline}}</view><view class="article">{{site.brandStory}}</view><customer-service label="微信客服 · 与我们聊一聊"/></view>
</view><view wx:if="{{error}}" class="error-bar">{{error}}</view>
