.chat-page{height:100vh;display:flex;flex-direction:column;background:var(--paper,#faf9f3);color:var(--ink,#344a3b);padding-bottom:env(safe-area-inset-bottom);box-sizing:border-box}.chat-heading{padding:32rpx 34rpx 22rpx;background:var(--soft,#e9eddf)}.chat-heading .heading{font-size:34rpx;margin:14rpx 0}.chat-store{padding:25rpx 34rpx;border-bottom:1rpx solid #e0e6d7;font-size:24rpx}.chat-store>view{display:flex;justify-content:space-between;gap:20rpx}.chat-store text{color:#71825e;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chat-native{display:flex;justify-content:space-between;padding:18rpx 34rpx;border-bottom:1rpx solid #e0e6d7;gap:18rpx}.chat-native button{font-size:23rpx;color:#59754e;padding:8rpx 0}.chat-messages{flex:1;min-height:0;box-sizing:border-box}.chat-empty{text-align:center;font-size:25rpx;color:#929c85;padding:80rpx 35rpx}.message-row{display:flex;justify-content:flex-start;padding:0 28rpx;margin-top:25rpx}.message-row.mine{justify-content:flex-end}.bubble{max-width:90%;background:#edf0e4;padding:20rpx 24rpx;border-radius:16rpx 16rpx 16rpx 0;box-sizing:border-box;overflow-wrap:anywhere;word-break:break-word}.mine .bubble{background:#dfe8d5;border-radius:16rpx 16rpx 0 16rpx}.message-meta{font-size:19rpx;color:#89947c;margin-bottom:12rpx}.bubble>text{font-size:27rpx;line-height:1.8;white-space:pre-wrap}.message-bottom{height:28rpx}.history{font-size:22rpx;color:#7e8d6e;padding:25rpx}.chat-compose{display:flex;align-items:flex-end;gap:18rpx;padding:20rpx 25rpx;border-top:1rpx solid #e0e6d7;background:var(--paper,#faf9f3)}.chat-compose textarea{flex:1;width:0;height:104rpx;min-height:104rpx;padding:16rpx 20rpx;font-size:25rpx}.chat-compose .primary{padding:23rpx 30rpx;font-size:26rpx;margin:0;min-width:125rpx}.chat-error{display:flex;align-items:center;justify-content:space-between;gap:15rpx;font-size:22rpx;line-height:1.8;color:#a16c50;background:#fbefe5;padding:15rpx 28rpx}.chat-error button{font-size:22rpx;color:#95603e;flex-shrink:0}
