:host{display:block}button{box-sizing:border-box;margin:0;background:transparent;color:inherit;font-size:25rpx;line-height:1.5;border-radius:5rpx}button::after{border:0}.native{border:1rpx solid #bdcdb2;background:#fffef8;color:#556e45;padding:22rpx;width:100%;text-align:center}.secondary{margin-top:20rpx}.online{font-size:22rpx;line-height:1.6;color:#738b61;padding:14rpx 8rpx 0}.error{font-size:20rpx;line-height:1.8;color:#9b6955;margin-top:10rpx}.compact .native,.inline .native{background:transparent;border:0;color:#607c51;padding:8rpx 12rpx;white-space:nowrap;font-size:24rpx}.compact .online{padding-top:0;font-size:20rpx}.inline .native{font-size:23rpx;padding:8rpx 0}.order .native{border-color:#d6dfcc;padding:17rpx 8rpx;font-size:23rpx;border-radius:4rpx;white-space:nowrap}.order .online{font-size:20rpx;padding-top:10rpx}
